PORT=3001
QLIK_HOST=https://dataiq-mexico.us.qlikcloud.com
QLIK_ASSISTANT_ID=47461ad6-1685-4ed6-a00a-e0f6224b3b0d
QLIK_APP_ID=replace-with-qlik-app-id
CLOUD_ASSISTANT_ID=replace-with-cloud-assistant-id
QLIK_WEB_INTEGRATION_ID=replace-with-web-integration-id

# Fallback token (dev only). If OAuth is configured and logged in, backend prefers OAuth user token.
QLIK_TOKEN=replace-with-your-token

# OAuth server-side (PKCE)
QLIK_OAUTH_CLIENT_ID=replace-with-oauth-client-id
QLIK_OAUTH_CLIENT_SECRET=
QLIK_OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
QLIK_OAUTH_SCOPES=openid profile email offline_access

# Local origins
BACKEND_ORIGIN=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:63343
